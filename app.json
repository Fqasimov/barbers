{
  "expo": {
    "name": "Usta",
    "slug": "usta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "usta",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3EFE8",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.usta.booking",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.usta.booking",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFE8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usta uses your location to show barbers and salons near you.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#B4233C",
          "defaultChannel": "bookings"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usta uses your photos so you can add pictures of your salon.",
          "cameraPermission": "Usta uses the camera so you can take pictures of your salon.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "az": "./locales/az.json",
      "ru": "./locales/ru.json",
      "en": "./locales/en.json"
    }
  }
}
