{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://yazilnow.az",
        "EXPO_PUBLIC_SITE_URL": "https://yazilnow.az",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@yazilnow.az",
        "EXPO_PUBLIC_PAYMENTS": "off"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://yazilnow.az",
        "EXPO_PUBLIC_SITE_URL": "https://yazilnow.az",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@yazilnow.az",
        "EXPO_PUBLIC_PAYMENTS": "off"
      }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://yazilnow.az",
        "EXPO_PUBLIC_SITE_URL": "https://yazilnow.az",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@yazilnow.az",
        "EXPO_PUBLIC_PAYMENTS": "off"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {}
    }
  }
}
