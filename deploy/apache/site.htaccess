# The website (https://yazilnow.az) on Apache / shared hosting (cPanel). deploy/build.sh copies this to out/site/.htaccess.
# On cPanel the subdomains live inside public_html, so the headers below apply to the main domain only.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS and the bare domain.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # QR codes, wall QR, shared salon links and the salon panel live in the app in a browser.
  RewriteRule ^(r|s|salon|u)/([A-Za-z0-9_-]+)/?$ https://app.yazilnow.az/$1/$2 [L,R=302,QSA]
  RewriteRule ^panel/?$ https://app.yazilnow.az/panel [L,R=302,QSA]
</IfModule>

<If "%{HTTP_HOST} =~ /^(www\.)?yazilnow\.az$/">
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://api.yazilnow.az; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
  <FilesMatch "\.(js|css|webp|png|jpg|svg|mp4|webm|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^(index\.html|config\.js|404\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(apple-app-site-association)$">
    Header set Content-Type "application/json"
  </FilesMatch>
</IfModule>
</If>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
