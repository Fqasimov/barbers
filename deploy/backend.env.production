# Production settings for the API (backend/.env on the server). Copy, then fill every value marked ⟵.
# Never commit the filled-in file. Generate APP_KEY on the server: php artisan key:generate

# ─── App ──────────────────────────────────────────────────────────────────
APP_NAME=yazılnow
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.yazilnow.az
# The website: QR review links are <WEB_URL>/r/<code>, wall QR <WEB_URL>/s/<salon>.
WEB_URL=https://yazilnow.az
APP_SCHEME=usta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Behind Cloudflare or a load balancer: its IPs, or * if only it can reach the server. Empty on a plain VPS.
TRUSTED_PROXIES=
# The website and the app in a browser.
CORS_ALLOWED_ORIGINS=https://yazilnow.az,https://www.yazilnow.az,https://app.yazilnow.az

# ─── Database ⟵ ───────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yazilnow
DB_USERNAME=yazilnow
DB_PASSWORD=

# ─── Sessions (admin panel), cache, queue ─────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_DOMAIN=api.yazilnow.az
# Sign-in tokens of the app last 90 days, then the app asks to sign in again. Empty: never expire.
SANCTUM_EXPIRATION_MINUTES=129600
CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── Mail ⟵ (sign-up codes, booking emails) ──────────────────────────────
# Any SMTP service (Zoho, Mailgun, Postmark, Amazon SES, your host's mail). Set SPF, DKIM and DMARC for the domain.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@yazilnow.az"
MAIL_FROM_NAME="yazılnow"

# ─── Photos ───────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public
PHOTO_DISK=public

# ─── Sign in with Google / Apple ⟵ (empty: those buttons fail politely) ──
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ─── Push ─────────────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── Payments: off until a provider is connected ──────────────────────────
# Must stay "provider" in production (the fake driver refuses to start there).
PAYMENT_DRIVER=provider
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER_NAME=provider
PAYMENT_BASE_URL=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_CALLBACK_SECRET=
PLAN_PRICE_SADE=10
PLAN_PRICE_START=29
PLAN_PRICE_PRO=49

# ─── WhatsApp pack (Meta Cloud API); "log" only writes to the log ─────────
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Support shown to salons ──────────────────────────────────────────────
SUPPORT_EMAIL=support@yazilnow.az
SUPPORT_HOURS=09:00–21:00
# Pro's phone line. Empty: Pro sees email support only.
SUPPORT_PHONE=
