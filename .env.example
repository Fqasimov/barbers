# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app,
# so put only public identifiers here — never secrets.

# Laravel API base URL. Leave empty to use the on-device demo backend.
EXPO_PUBLIC_API_URL=

# Google OAuth client IDs (Google Cloud Console → Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Laravel API base URL without "/api", e.g. https://api.ustatap.az (local: http://<LAN-IP>:8000).
# (EXPO_PUBLIC_API_URL above.) Production builds refuse to build without it.

# Public website (privacy policy, terms) and support email.
EXPO_PUBLIC_SITE_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# iOS: show the subscription buy button. Off by default (App Store rule 3.1.1); see docs/api.md → Payments.
EXPO_PUBLIC_IOS_CHECKOUT=
