# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app,
# so put only public identifiers here — never secrets.

# Laravel API base URL. Leave empty to use the on-device demo backend.
EXPO_PUBLIC_API_URL=

# Google OAuth client IDs (Google Cloud Console → Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
