# ─── App ──────────────────────────────────────────────────────────────────
APP_NAME=Usta
# local | testing | production. In `local` the OTP challenge also returns
# `demo_code` (for the app's demo banner) and the demo catalogue is seeded.
APP_ENV=local
# php artisan key:generate. Also keys the OTP hashes and the fake payment signature.
APP_KEY=
APP_DEBUG=true
# Public base URL (https in production). Photo URLs and /billing/return use it.
APP_URL=http://localhost:8000
# The mobile app's URL scheme: /billing/return redirects to <scheme>://billing/return.
APP_SCHEME=usta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Comma separated proxy IPs, or * behind a trusted load balancer (for real client IPs in rate limits).
TRUSTED_PROXIES=

# Origins allowed by CORS (the Expo web build). Native apps don't need this.
CORS_ALLOWED_ORIGINS=http://localhost:8081

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────
# sqlite for local dev (database/database.sqlite); mysql (8+) or pgsql in production.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=usta
# DB_USERNAME=usta
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production: the admin panel's session cookie is only sent over HTTPS.
SESSION_SECURE_COOKIE=false

# API tokens never expire unless set (minutes).
SANCTUM_EXPIRATION_MINUTES=

BROADCAST_CONNECTION=log
CACHE_STORE=database
# CACHE_PREFIX=

# ─── Queue ────────────────────────────────────────────────────────────────
# Mail and push go through the queue. `database` works out of the box (run
# `php artisan queue:work`); `redis` is better under load; `sync` sends inline.
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (OTP codes, booking and trial emails) ───────────────────────────
# `log` writes mails to storage/logs in development. Production: smtp/ses/
# postmark/resend from the domain's own address with SPF, DKIM and DMARC set.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@usta.az"
MAIL_FROM_NAME="Usta"

# ─── Files ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public
# Disk for salon photos; must give absolute public URLs (public, or s3 + AWS_URL/CDN).
# With `public`, run `php artisan storage:link`.
PHOTO_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Social sign-in ───────────────────────────────────────────────────────
# id_token `aud` must be one of these (comma separated). Google: the iOS,
# Android and Web OAuth client IDs. Apple: the iOS bundle ID (and Services ID
# if you add web sign-in).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ─── Push ─────────────────────────────────────────────────────────────────
# Only if "Enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# ─── Payments ─────────────────────────────────────────────────────────────
# fake (local/testing only, refused in production) | provider (the real
# acquirer, app/Payments/ProviderGateway.php — still a stub).
PAYMENT_DRIVER=fake
# Optional HMAC key for fake callbacks (defaults to APP_KEY).
PAYMENT_FAKE_SECRET=
# For PAYMENT_DRIVER=provider, once a provider is chosen:
PAYMENT_PROVIDER_NAME=provider
PAYMENT_BASE_URL=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=
PAYMENT_CALLBACK_SECRET=

# Monthly plan prices in AZN (served by GET /api/plans).
# false: nothing can be bought and no deposits are taken (testing).
PAYMENTS_ENABLED=true
PLAN_PRICE_SADE=10
PLAN_PRICE_START=29
PLAN_PRICE_PRO=49
# Yearly prices; default to 10 × the monthly price (12 months for the price of 10).
# PLAN_PRICE_START_YEAR=290
# PLAN_PRICE_PRO_YEAR=490
